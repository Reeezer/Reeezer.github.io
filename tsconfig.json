{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  // Duplicated from tsconfig.app.json so the shadcn CLI, which only reads the
  // root config, resolves the "@/" alias instead of writing to a literal "@" dir.
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
